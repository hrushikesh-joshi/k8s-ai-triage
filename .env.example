# Copy this file to .env and fill in your real key.
# .env is loaded automatically by app.py via python-dotenv (see load_dotenv() call).
# Never commit the real .env file — it's already excluded in .gitignore.

ANTHROPIC_API_KEY=sk-ant-your-real-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Optional cluster/topology overrides — all have sane defaults in app.py
EKS_CLUSTER_NAME=eks-prod-payments-usw2
AWS_REGION=us-west-2
K8S_NAMESPACE=payment
